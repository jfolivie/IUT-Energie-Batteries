ax.text(t_comp[2], l_comp[2]-0.14, r_comp[2]+0.14, '$LiNi_{1/3}Co_{1/3}Mn_{1/3}O_2$', ha='center', va='center')

ax.scatter([0],[0],[1], color = 'red', s = 400, label = "Stabilité en cyclage")
