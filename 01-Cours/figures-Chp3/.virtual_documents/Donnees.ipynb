ax.set_tlabel("$LiMn_2O_4$",color='green')
ax.set_llabel("$LiNiO_2$",color = 'blue')
ax.set_rlabel("$LiCoO_2$", color = 'red')

ax.plot([1/3, 1/3], [0, 1], transform=ax.get_raxis_transform(), color = 'black')
