           color='white', s=100, edgecolors = "black", linewidth=2,alpha=1,zorder=3)


ax.text(t_comp[0]+0.02, l_comp[0]-0.1, r_comp[0]+0.1, '$LiNi_{2/3}Co_{1/3}O_2$', ha='center', va='center')
