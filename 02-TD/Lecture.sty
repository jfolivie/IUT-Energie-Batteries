\end{tcolorbox}
}

\newcommand{\objectives}[1]{
\begin{tcolorbox}[breakable,colback=tagada!5!white,colframe=tagada!75!black,title={\textsc{Compétences} }] 
#1
\end{tcolorbox}
}

\newcommand{\definition}[1]{
\begin{tcolorbox}[breakable,colback=tagada!5!white,colframe=tagada!75!black,title={\textsc{Définition} }] 
